import time 
import datetime

current_time = datetime.datetime(2025, 10, 28, 6, 15, 0)         #The time when the routine starts
print('Sleep')                                                   #Display Sleep

while True :
    alarm = input('Alarm?? ').lower()                           #turn all of users answers lower case

    if alarm == 'yes': 
        print('wake up')                                        #Display wake up
        current_time += datetime.timedelta(minutes=1)           #Display time + 1 minute 
        break                                                   #End loop and move to next action
    elif alarm == 'no':
        print('go back to sleep for 5 mintues')                 #Display go back to sleep for 5 minutes 
        time.sleep(2)
        current_time += datetime.timedelta (minutes=5)          #Display time + 1 minute 
    else: 
        print('invalid responce')                               #Display invalid response 
print(current_time.strftime("%H:%M:%S"))
